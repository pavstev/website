{
  "name": "website-astro",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "astro": "astro",
    "audit:site": "node scripts/audit/index.ts",
    "build": "export BLOG_BUILT_AT=$(node -p \"new Date().toISOString()\") && astro build && node scripts/preload-guard.ts && node scripts/meta-guard.ts && node scripts/timeline-guard.ts",
    "check": "pnpm types && prettier --check . --cache --log-level=warn && eslint . --max-warnings=0 --cache && astro check && tsc --noEmit -p worker/tsconfig.json && node --test --test-reporter=dot \"scripts/**/*.test.ts\" \"src/**/*.test.ts\" \"worker/**/*.test.ts\" && knip && knip --production --include files && pnpm build && node src/profile/cli.ts --check",
    "check:fast": "node scripts/check-fast.ts",
    "dev": "astro dev --port 4321",
    "dev:many": "export BLOG_FIXTURES=1 && node scripts/blog-fixtures.ts && pnpm dev",
    "fix": "prettier --write . --cache --log-level=warn && eslint . --fix --max-warnings=0 --cache",
    "icons": "node scripts/generate-icon-data.ts",
    "land": "node scripts/generate-land-map.ts",
    "moon": "node scripts/generate-moon-map.ts",
    "places": "node scripts/generate-places.ts",
    "prepare": "husky && pnpm types",
    "preview": "astro preview --port 4321",
    "profile:build": "node src/profile/cli.ts",
    "test:e2e": "node --test --test-reporter=spec scripts/site.e2e.ts",
    "types": "CLOUDFLARE_LOAD_DEV_VARS_FROM_DOT_ENV=false wrangler types > /dev/null && astro sync > /dev/null"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.6",
    "@astrojs/mdx": "^8.1.3",
    "@astrojs/react": "^7.1.4",
    "@floating-ui/dom": "^1.8.0",
    "@fontsource/inter": "^5.3.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "astro": "^7.4.7",
    "motion": "^12.43.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-mdx": "^3.1.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "satori": "^0.63.2",
    "sharp": "^0.35.5",
    "shiki": "^4.6.0",
    "three": "^0.187.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.2.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@eslint/markdown": "^8.0.3",
    "@tailwindcss/vite": "^4.3.5",
    "@types/hast": "^3.0.5",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-better-tailwindcss": "^4.10.0",
    "eslint-plugin-import-x": "^4.18.0",
    "eslint-plugin-perfectionist": "^5.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-regexp": "^3.3.3",
    "eslint-plugin-security": "^4.2.1",
    "eslint-plugin-unicorn": "^77.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "html-validate": "^11.19.0",
    "husky": "^9.1.7",
    "knip": "^6.44.2",
    "lighthouse": "13.6.0",
    "playwright-core": "^1.65.0",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.2",
    "prettier-plugin-packagejson": "^3.1.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "schema-dts": "^2.1.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "wrangler": "^4.158.0"
  },
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=24.15",
    "pnpm": ">=12"
  }
}
