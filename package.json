{
  "name": "website-astro",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "astro": "astro",
    "build": "export BLOG_BUILT_AT=$(node -p \"new Date().toISOString()\") && node scripts/cv-fetch.ts && node scripts/blog-build.ts && astro build && node scripts/preload-guard.ts && node scripts/meta-guard.ts && node scripts/cv-guard.ts",
    "check": "prettier --check . --cache --log-level=warn && eslint . --max-warnings=0 --cache && astro check && tsc --noEmit -p worker/tsconfig.json && node --test \"scripts/**/*.test.ts\" \"src/**/*.test.ts\" \"worker/**/*.test.ts\" && knip && pnpm build && node src/profile/cli.ts --check",
    "dev": "node scripts/cv-fetch.ts && BLOG_DRAFTS=1 node scripts/blog-build.ts && astro dev --port 4321",
    "dev:many": "export BLOG_FIXTURES=1 && pnpm dev",
    "fix": "prettier --write . --cache --log-level=warn && eslint . --fix --max-warnings=0 --cache",
    "icons": "node scripts/generate-icon-data.ts",
    "prepare": "husky",
    "preview": "astro preview --port 4321",
    "profile:build": "node src/profile/cli.ts",
    "stars:build": "node scripts/generate-star-data.ts"
  },
  "dependencies": {
    "@astrojs/react": "^7.0.1",
    "@floating-ui/dom": "^1.8.0",
    "@fontsource/inter": "^5.3.0",
    "@mdx-js/mdx": "^3.1.1",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@react-pdf/renderer": "^4.9.0",
    "@shikijs/rehype": "^4.5.0",
    "astro": "^7.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-mdx": "^3.1.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "sanitize-html": "2.18.0",
    "satori": "^0.55.1",
    "shiki": "^4.5.0",
    "three": "^0.186.1",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "vfile": "^6.0.3",
    "vfile-matter": "^5.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@eslint/markdown": "^8.0.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/hast": "^3.0.5",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sanitize-html": "2.16.2",
    "@types/three": "^0.186.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-better-tailwindcss": "^4.9.0",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-perfectionist": "^5.12.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-regexp": "^3.3.1",
    "eslint-plugin-security": "^4.2.0",
    "eslint-plugin-unicorn": "^77.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "husky": "^9.1.7",
    "knip": "^6.39.0",
    "playwright-core": "^1.64.0",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.1",
    "prettier-plugin-packagejson": "^3.0.2",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "schema-dts": "^2.1.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "wrangler": "^4.147.0"
  },
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=24.15",
    "pnpm": ">=12"
  }
}
