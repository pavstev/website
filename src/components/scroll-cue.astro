---
import { en } from "@/lib/i18n";

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<p aria-hidden="true" class:list={["scroll-cue", className]}>
  <span class="scroll-cue-word type-chip">{en.scroll.cue}</span>
  <span class="scroll-cue-line">
    <span class="scroll-cue-drip"></span>
  </span>
</p>
