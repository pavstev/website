<div aria-hidden="true" class="sky-dial">
  <svg class="sky-dial-ring" viewBox="0 0 100 100">
    <circle cx="50" cy="50" r="50" vector-effect="non-scaling-stroke"></circle>
    <line
      class="sky-dial-horizon"
      vector-effect="non-scaling-stroke"
      x1="0"
      x2="100"
      y1="50"
      y2="50"
    ></line>
  </svg>
  <span class="sky-dial-orbit">
    <span class="sky-dial-dot"></span>
  </span>
</div>
