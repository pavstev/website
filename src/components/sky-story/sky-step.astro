---
import ScrollCue from "@/components/scroll-cue.astro";
import { type SkyStorySlide } from "@/data/website-story";
import { posterStyle, type StoryPoster } from "@/lib/sky-story-poster";

interface Props {
  poster: StoryPoster;
  slide: SkyStorySlide;
}

const { poster, slide } = Astro.props;
const hero = slide.id === "hero";
const Heading = hero ? "h1" : "h2";
---

<li
  class="sky-step scroll-step"
  data-bright={poster.bright ? "" : undefined}
  data-step={slide.id}
  id={slide.id === "outro" ? "sky-story-end" : undefined}
  style={`--scroll-screens: ${String(slide.screens)}; ${posterStyle(poster)}`}
>
  <div class="sky-step-body scroll-body scroll-text">
    <p class="sky-step-eyebrow scroll-eyebrow type-chip text-sky">
      <span
        aria-hidden="true"
        class="sky-step-lamp scroll-lamp"
        data-lamp={slide.lamp}
      ></span>
      {slide.clock !== undefined && (
        <span class="sky-step-clock">{slide.clock}</span>
      )}
      <span class="sky-step-chapter">{slide.chapter}</span>
    </p>
    <Heading
      class:list={[
        "sky-step-line",
        "scroll-line",
        { "scroll-line-hero": hero },
        "text-sky",
      ]}
    >
      {slide.line}
    </Heading>
    <p class="sky-step-note scroll-note text-sky">{slide.note}</p>
    {hero && <ScrollCue class="sky-step-cue" />}
    <slot />
  </div>
</li>
