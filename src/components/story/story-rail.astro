---
import { en } from "@/lib/i18n";
import { fillText } from "@/lib/template";
import { type StoryStep } from "@/lib/story/steps";

interface Props {
  skills: readonly string[];
  steps: readonly StoryStep[];
}

const { skills, steps } = Astro.props;
const ticks = steps.filter((step) => step.tick);
const chapters: Record<string, string> = en.story.chapters;
---

<nav aria-label={en.story.railLabel} class="story-rail">
  <ol class="story-rail-list">
    {ticks.map((step) => (
      <li class="story-rail-item">
        <button
          aria-label={fillText(en.story.railTick, {
            chapter: chapters[step.id] ?? step.eyebrow,
            line: step.line,
          })}
          class="story-tick focus-ring"
          data-tick={step.id}
          type="button"
        ></button>
        {step.id === "skills" && (
          <ol class="story-rail-subs">
            {skills.map((skill, index) => (
              <li>
                <button
                  aria-label={fillText(en.story.railSkill, {
                    index: String(index + 1),
                    skill,
                    total: String(skills.length),
                  })}
                  class="story-sub focus-ring"
                  data-sub={String(index)}
                  data-sub-step={step.id}
                  type="button"
                ></button>
              </li>
            ))}
          </ol>
        )}
      </li>
    ))}
  </ol>
</nav>
