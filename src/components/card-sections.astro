---
import { Icon } from "@/components/icon";
import { en } from "@/lib/i18n";

const sections = [
  { href: "/about", icon: "lucide:user-round", label: en.card.about },
  { href: "/work", icon: "lucide:briefcase", label: en.card.work },
  { href: "/blog", icon: "lucide:notebook-pen", label: en.card.blog },
];
---

<ul
  aria-label={en.card.sections}
  class="section-row fade-up relative z-1 mt-(--card-gap-sections) delay-3"
  data-proximity=""
  data-sections=""
>
  {sections.map((section) => (
    <li class="section-item">
      <a class="section-link keycap-host focus-ring" href={section.href}>
        <span aria-hidden="true" class="keycap-base" />
        <span class="keycap">
          <span aria-hidden="true" class="section-icon contact-icon">
            <Icon name={section.icon} size="0.9375rem" />
          </span>
          <span class="section-label">{section.label}</span>
        </span>
      </a>
    </li>
  ))}
</ul>
