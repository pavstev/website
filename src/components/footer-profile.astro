---
import { Icon } from "@/components/icon";
import { getContact } from "@/lib/github";
import { en } from "@/lib/i18n";
import { personalData } from "@/lib/personal";

const contact = await getContact(personalData.githubHandle);
const links = [
  {
    external: true,
    href: personalData.github,
    icon: "simple-icons:github",
    label: en.card.github,
  },
  {
    external: true,
    href: contact.linkedin,
    icon: "simple-icons:linkedin",
    label: en.card.linkedin,
  },
  {
    external: false,
    href: `mailto:${contact.email}`,
    icon: "lucide:mail",
    label: en.card.email,
  },
  {
    external: false,
    href: "/resume.pdf",
    icon: "lucide:download",
    label: en.card.resume,
  },
];
---

<section aria-label={en.blog.footerLabel} class="footer-profile">
  <div class="footer-profile-id">
    <p class="footer-profile-name">{personalData.name}</p>
    <p class="footer-profile-role">{en.blog.footerRole}</p>
  </div>
  <ul class="footer-profile-links">
    {links.map((link) => (
      <li>
        <a
          class="footer-profile-link focus-ring"
          data-astro-reload={link.external ? undefined : ""}
          href={link.href}
          rel={link.external ? "me noopener noreferrer" : undefined}
          target={link.external ? "_blank" : undefined}
        >
          <Icon name={link.icon} size="1rem" />
          <span>{link.label}</span>
          {link.external && <span class="sr-only"> {en.card.newTab}</span>}
        </a>
      </li>
    ))}
  </ul>
</section>
