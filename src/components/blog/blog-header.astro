---
import AuthorPhoto from "@/components/blog/author-photo.astro";
import { BarSpy } from "@/components/blog/bar-spy";
import { Icon } from "@/components/icon";
import { MotionToggle } from "@/components/motion-toggle";
import { ReadingProgress } from "@/components/ui/reading-progress";
import { type Crumb, crumbIsLink } from "@/lib/blog/crumbs";
import { en } from "@/lib/i18n";

interface Props {
  crumbs: Crumb[];
  slug?: string;
  title: string;
  toc?: boolean;
}

const { crumbs, slug, title, toc = false } = Astro.props;
---

<div
  class="blog-bar"
  data-blog-bar=""
  data-sub={slug === undefined ? undefined : ""}
>
  <div aria-hidden="true" class="blog-bar-glass"></div>
  {slug !== undefined && (
    <ReadingProgress
      client:load
      className="reading-progress"
      fillClassName="reading-progress-fill"
      label={en.blog.readingProgress}
      target=".prose-blog"
      valueText={en.blog.readingProgressValue}
    />
  )}
  <div class="blog-bar-row">
    <nav aria-label={en.blog.crumbsLabel} class="blog-crumbs">
      <ol class="blog-crumbs-list">
        {crumbs.map((crumb, index) => (
          <li class="blog-crumbs-item" data-home={index === 0 ? "" : undefined}>
            {index > 0 && (
              <span aria-hidden="true" class="blog-crumbs-sep">
                /
              </span>
            )}
            {crumbIsLink(crumb) ? (
              <a
                aria-current={crumb.current ? "page" : undefined}
                class="blog-crumbs-link focus-ring"
                href={crumb.path}
              >
                {index === 0 && (
                  <AuthorPhoto
                    alt=""
                    class="blog-crumbs-photo"
                    sizes="1.5rem"
                  />
                )}
                <span class={index === 0 ? "blog-crumbs-home" : undefined}>
                  {crumb.label}
                </span>
              </a>
            ) : (
              <span aria-current="page" class="blog-crumbs-here">
                {crumb.label}
              </span>
            )}
          </li>
        ))}
      </ol>
    </nav>
    {toc && (
      <button
        aria-controls="toc-drawer"
        aria-haspopup="dialog"
        aria-label={en.blog.toc}
        class="blog-bar-toc keycap-host focus-ring"
        data-css-press=""
        data-toc-open=""
        type="button"
      >
        <span aria-hidden="true" class="keycap-base"></span>
        <span class="keycap">
          <Icon name="lucide:list" size="0.9375rem" />
          <span aria-hidden="true" class="blog-bar-toc-label">
            {en.blog.toc}
          </span>
        </span>
      </button>
    )}
    <div class="blog-bar-slot" data-bar-slot="">
      <MotionToggle client:load variant="bar" />
    </div>
  </div>
</div>
<BarSpy client:load />
<header class="blog-header" data-sky-header="">
  <p class="blog-header-meta type-chip text-sky">
    <slot name="meta" />
  </p>
  <h1 class="blog-title text-sky" id="blog-title">
    {title}
  </h1>
  <slot />
</header>
