---
import { FooterContacts } from "@/components/footer-contacts";
import MotionSwitch from "@/components/motion-switch.astro";
import { SkyControls } from "@/components/sky-controls";
import { blogLive } from "@/lib/blog/live";
import { footerLinks } from "@/lib/footer-links";
import { getContact } from "@/lib/github";
import { en } from "@/lib/i18n";
import { personalData } from "@/lib/personal";
import { getResumeFacts } from "@/lib/resume-facts";

interface Props {
  className: string;
  links?: boolean;
}

const { className, links = false } = Astro.props;
const year = new Date().getFullYear();
const keys = links
  ? footerLinks(await getContact(personalData.githubHandle), blogLive())
  : [];
const facts = links ? await getResumeFacts() : undefined;
---

{links ? (
  <footer class={`${className} footer-night`}>
    <div class="footer-row">
      <div class="footer-left">
        <span class="footer-copy">
          <span class="footer-words">
            <span>© {year}</span> <span>{personalData.name}</span>
          </span>
        </span>
        <span class="footer-motion">
          <MotionSwitch />
        </span>
      </div>
      {facts && <FooterContacts client:idle facts={facts} links={keys} />}
    </div>
  </footer>
) : (
  <div class={`${className} type-chip`}>
    <div class="footer-tiers tabular text-sky">
      <div class="footer-tier">
        <span class="footer-copy">
          <span class="footer-words">
            <span>© {year}</span> <span>{personalData.name}</span>
          </span>
        </span>
      </div>
      <div class="footer-tier">
        <SkyControls client:idle={{ timeout: 1000 }}>
          <MotionSwitch hint />
        </SkyControls>
        <a
          class="footer-credit focus-ring"
          href={en.weather.creditUrl}
          rel="noopener noreferrer"
          target="_blank"
        >
          <span class="footer-words">
            {en.weather.credit.split(" ").map((word, index) => (
              <>
                {index > 0 && " "}
                <span>{word}</span>
              </>
            ))}
          </span>
          <span class="sr-only"> {en.card.newTab}</span>
        </a>
      </div>
    </div>
  </div>
)}
