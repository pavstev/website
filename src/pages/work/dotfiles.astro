---
import BlogHeader from "@/components/blog/blog-header.astro";
import { Icon } from "@/components/icon";
import ScrollProgress from "@/components/scroll-progress.astro";
import ScrollRail from "@/components/scroll-rail.astro";
import StoryStage from "@/components/story/story-stage.astro";
import StoryStep from "@/components/story/story-step.astro";
import { storyMeta } from "@/data/dotfiles-stats";
import {
  bootstrapLine,
  sceneCounts,
  skillCopy,
  skillEntries,
  skillFacts,
  storyNames,
  uninstallLine,
} from "@/data/dotfiles-story";
import BlogLayout from "@/layouts/BlogLayout.astro";
import "@/styles/story.css";
import { type Crumb } from "@/lib/blog/crumbs";
import { getDotfilesFacts } from "@/lib/dotfiles-facts";
import { en } from "@/lib/i18n";
import { personalData } from "@/lib/personal";
import { buildScene } from "@/lib/story/blueprint-geometry";
import { posterSvg, sceneSvg } from "@/lib/story/blueprint-svg";
import { skillMap } from "@/lib/story/skill-map";
import { fillText } from "@/lib/template";
import { storyMetadata } from "@/lib/story/metadata";
import { dotfilesStory } from "@/lib/work";
import { buildSteps } from "@/lib/story/steps";
import { serializeJsonLd, storyGraph } from "@/lib/structured-data";

const facts = await getDotfilesFacts();
const counts = sceneCounts(facts);
const steps = buildSteps(facts);
const namesFor: Record<string, typeof storyNames.hero> = storyNames;
const posterAttrs = (kind: "tall" | "wide"): string =>
  `class="story-poster story-poster-${kind}" preserveAspectRatio="xMidYMid meet"`;
const wide = posterSvg(1440, 900, counts, posterAttrs("wide"));
const tall = sceneSvg(
  buildScene("outro", 1, 1, counts, 0),
  390,
  844,
  posterAttrs("tall")
);
const map = skillMap(skillEntries, facts.skillNames);
const skills = skillCopy(facts.skillNames);
const chartLines = skillFacts(facts.skillNames);
const railTicks = steps
  .filter((step) => step.tick)
  .map((step) => ({
    id: step.id,
    name: fillText(en.story.railTick, {
      chapter: step.eyebrow,
      line: step.line,
    }),
  }));
const railSubs = {
  names: skills.map((item, index) =>
    fillText(en.story.railSkill, {
      index: String(index + 1),
      skill: item.skill,
      total: String(skills.length),
    })
  ),
  step: "skills",
};
const skillPoster = sceneSvg(
  buildScene("skills", 1, 1, counts, Infinity, map),
  720,
  540,
  'class="story-skill-poster"'
);
const crumbs: Crumb[] = [
  { current: false, label: en.blog.crumbHome, path: "/" },
  { current: false, label: en.work.heading, path: "/work" },
  { current: true, label: en.story.crumb, path: dotfilesStory },
];
const repoUrl = `${personalData.github}/dotfiles`;
const jsonLd = serializeJsonLd(storyGraph(storyMeta.updatedAt));
---

<BlogLayout metadata={storyMetadata()} sky={false}>
  <script type="application/ld+json" is:inline set:html={jsonLd}></script>
  <main class="blog-main" id="main-content">
    <BlogHeader crumbs={crumbs} title={en.story.metaTitle} />
    <a class="skip-link mat-pop type-chip focus-ring" href="#story-end">
      {en.story.skipToEnd}
    </a>
    <section
      class="story scroll-story"
      data-story-counts={JSON.stringify(counts)}
      data-story-root=""
      data-story-skills={JSON.stringify(map)}
    >
      <ScrollProgress />
      <ScrollRail
        label={en.story.railLabel}
        subs={railSubs}
        ticks={railTicks}
      />
      <StoryStage tall={tall} wide={wide} />
      <ol class="story-steps scroll-steps">
        {steps.map((step) => (
          <StoryStep
            names={namesFor[step.id] ?? []}
            step={step}
            stops={step.id === "skills" ? skills.length : undefined}
          >
            {step.id === "skills" && (
              <div class="story-skills">
                <ol aria-label={en.story.skillsList} class="story-skill-list">
                  {skills.map((item) => (
                    <li class="story-skill" data-plate="">
                      <span class="story-strip-name">{item.skill}</span>
                      <span class="story-strip-row">
                        {item.phase} · {item.what}
                      </span>
                      <span class="story-strip-row">{item.flow}</span>
                    </li>
                  ))}
                </ol>
                {chartLines.map((line) => (
                  <p class="story-skill-fact">{line}</p>
                ))}
                <Fragment set:html={skillPoster} />
              </div>
            )}
            {step.id === "outro" && (
              <div class="story-outro">
                <p class="story-label">{en.story.install}</p>
                <code class="story-install">{bootstrapLine}</code>
                <div class="scroll-actions">
                  <button
                    aria-label={en.story.copyLine}
                    class="keycap-host focus-ring"
                    data-copied={en.blog.codeCopied}
                    data-copy={bootstrapLine}
                    data-failed={en.story.copyFailed}
                    type="button"
                  >
                    <span class="keycap story-copy">
                      <span data-face="idle">{en.story.copy}</span>
                      <span data-face="copied">{en.blog.codeCopied}</span>
                      <span data-face="failed">{en.story.copyFailed}</span>
                    </span>
                  </button>
                  <span class="sr-only" data-copy-status role="status" />
                  <a
                    class="keycap-host focus-ring"
                    href={repoUrl}
                    rel="noopener noreferrer"
                    target="_blank"
                  >
                    <span class="keycap">
                      <Icon
                        aria-hidden
                        name="simple-icons:github"
                        size="0.9375rem"
                      />
                      {en.story.onGithub}
                      <span class="sr-only"> {en.card.newTab}</span>
                    </span>
                  </a>
                </div>
                <p class="story-label">{en.story.takeItBack}</p>
                <code class="story-install">{uninstallLine}</code>
                <a class="keycap-host focus-ring story-back" href="/work">
                  <span class="keycap">
                    <Icon
                      aria-hidden
                      name="lucide:arrow-left"
                      size="0.9375rem"
                    />
                    {en.story.backToWork}
                  </span>
                </a>
              </div>
            )}
          </StoryStep>
        ))}
      </ol>
    </section>
  </main>
</BlogLayout>
