---
import PostBody from "@/components/blog/post-body.astro";
import PostHeader from "@/components/blog/post-header.astro";
import PostNav from "@/components/blog/post-nav.astro";
import SiteFooter from "@/components/site-footer.astro";
import BlogLayout from "@/layouts/BlogLayout.astro";
import { showDrafts } from "@/lib/blog/build-env";
import { postCrops } from "@/lib/blog/media";
import { postMetadata, postShareImage } from "@/lib/blog/metadata";
import { findPost, listPosts } from "@/lib/blog/posts";
import { renderPost } from "@/lib/blog/render";
import { personalData } from "@/lib/personal";
import { postGraph, serializeJsonLd } from "@/lib/structured-data";

export const getStaticPaths = (): Array<{ params: { slug: string } }> =>
  listPosts({ drafts: showDrafts() }).map((post) => ({
    params: { slug: post.slug },
  }));

const { slug = "" } = Astro.params;
const drafts = { drafts: showDrafts() };
const source = findPost(slug, drafts);
if (source === undefined) throw new Error(`blog: no post ${slug}`);
const { html, toc } = await renderPost(source);
const posts = listPosts(drafts);
const index = posts.findIndex((post) => post.slug === slug);
const image = postShareImage(source.meta);
const jsonLd = serializeJsonLd(
  postGraph(source.meta, [
    {
      height: image.height,
      url: `${personalData.website}${image.url}`,
      width: image.width,
    },
    ...postCrops(slug, personalData.website),
  ])
);
---

<BlogLayout metadata={postMetadata(source.meta)}>
  <script type="application/ld+json" is:inline set:html={jsonLd} />
  <main class="blog-main post-main" id="main-content">
    <PostHeader post={source.meta} toc={toc.length > 0} />
    <div class="post-page">
      <PostBody html={html} toc={toc} />
      <PostNav newer={posts[index - 1]} older={posts[index + 1]} />
      <SiteFooter className="blog-footer" links rss />
    </div>
  </main>
</BlogLayout>
