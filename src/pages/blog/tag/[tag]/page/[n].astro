---
import BlogIndex from "@/components/blog/blog-index.astro";
import BlogLayout from "@/layouts/BlogLayout.astro";
import "@/styles/post.css";
import { showDrafts } from "@/lib/blog/build-env";
import {
  listingMetadata,
  listingPage,
  listingParams,
} from "@/lib/blog/listing-route";
import { listPosts } from "@/lib/blog/posts";

export const getStaticPaths = (): Array<{
  params: { n: string; tag: string };
}> =>
  listingParams(listPosts({ drafts: showDrafts() }))
    .filter(({ rest, slug }) => slug === "tag" && rest.length === 3)
    .map(({ rest: [tag = "", , n = ""] }) => ({ params: { n, tag } }));

const { n = "", tag = "" } = Astro.params;
const page = listingPage(listPosts({ drafts: showDrafts() }), {
  rest: [tag, "page", n],
  slug: "tag",
});
if (page === undefined) throw new Error(`blog: no tag page ${tag} ${n}`);
---

<BlogLayout metadata={listingMetadata(page)}>
  <BlogIndex heading={page.heading} listing={page.listing} />
</BlogLayout>
