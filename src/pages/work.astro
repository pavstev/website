---
import BlogHeader from "@/components/blog/blog-header.astro";
import { WorkGrid } from "@/components/work-grid";
import BlogLayout from "@/layouts/BlogLayout.astro";
import "@/styles/work.css";
import { pageCrumbs } from "@/lib/blog/crumbs";
import { listMetadata } from "@/lib/blog/metadata";
import { getRepos } from "@/lib/github";
import { en } from "@/lib/i18n";
import { personalData } from "@/lib/personal";
import { products as allProducts } from "@/lib/products";
import { serializeJsonLd, workGraph } from "@/lib/structured-data";
import { countHeading } from "@/lib/template";
import { pickProducts } from "@/lib/work";
import { withFixtureProducts, withFixtureRepos } from "@/lib/work-fixtures";

const repos = withFixtureRepos(await getRepos(personalData.githubHandle));
const products = withFixtureProducts(pickProducts(allProducts));
const jsonLd = serializeJsonLd(workGraph(products));
const metadata = listMetadata({
  description: en.work.metaDescription,
  title: en.work.metaTitle,
  url: `${personalData.website}/work`,
});
---

<BlogLayout metadata={metadata}>
  <script type="application/ld+json" is:inline set:html={jsonLd}></script>
  <main class="blog-main" id="main-content">
    <BlogHeader
      crumbs={pageCrumbs(en.work.heading, "/work")}
      title={en.work.heading}
    >
      <Fragment slot="meta">
        <span>{countHeading(products.length, en.products)}</span>
        <span aria-hidden="true"> · </span>
        <span>{countHeading(repos.length, en.repos)}</span>
      </Fragment>
    </BlogHeader>
    <div class="post-layout">
      <div class="blog-index page-wide work-page">
        <span hidden id="work-new-tab">
          {en.repos.newTab}
        </span>
        <WorkGrid newTabId="work-new-tab" products={products} repos={repos} />
      </div>
    </div>
  </main>
</BlogLayout>
<script>
  import { watchRepoTips } from "@/lib/repo-tips";
  import { watchWorkControls } from "@/lib/work-controls";

  watchRepoTips();
  watchWorkControls();
</script>
