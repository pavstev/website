---
import { getEntry, render } from "astro:content";

import BlogHeader from "@/components/blog/blog-header.astro";
import { mdxComponents } from "@/components/blog/mdx-components";
import PostBody from "@/components/blog/post-body.astro";
import PostFigure from "@/components/blog/post-figure.astro";
import BlogLayout from "@/layouts/BlogLayout.astro";
import { pageCrumbs } from "@/lib/blog/crumbs";
import { listMetadata } from "@/lib/blog/metadata";
import { getCv } from "@/lib/cv";
import { getContact } from "@/lib/github";
import { en } from "@/lib/i18n";
import { personalData } from "@/lib/personal";
import { aboutGraph, serializeJsonLd } from "@/lib/structured-data";

const entry = await getEntry("about", "index");
if (entry === undefined) throw new Error("content/about/index.mdx is missing");
const { Content } = await render(entry);
const { data } = entry;
const [contact, cv] = await Promise.all([
  getContact(personalData.githubHandle),
  getCv(),
]);
const jsonLd = serializeJsonLd(
  aboutGraph(contact, data.description, cv.updatedAt)
);
const metadata = listMetadata({
  description: data.description,
  title: en.about.metaTitle,
  type: "profile",
  url: `${personalData.website}/about`,
});
const components = {
  ...mdxComponents({ dir: "content/about", slug: "about" }),
  Figure: PostFigure,
};
---

<BlogLayout metadata={metadata}>
  <script type="application/ld+json" is:inline set:html={jsonLd}></script>
  <main class="blog-main post-main" id="main-content">
    <BlogHeader
      crumbs={pageCrumbs(en.about.crumb, "/about")}
      title={data.title}
    >
      <Fragment slot="meta">
        <span>{personalData.title}</span>
      </Fragment>
      <p class="about-lead text-sky">{data.lead}</p>
    </BlogHeader>
    <div class="post-page page-wide about-page">
      <PostBody toc={[]}>
        <Content components={components} />
      </PostBody>
    </div>
  </main>
</BlogLayout>
