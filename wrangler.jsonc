{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "website",
  "main": "worker/index.ts",
  "compatibility_date": "2026-03-18",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": true,
  "assets": {
    "directory": "dist",
    "not_found_handling": "404-page",
    "binding": "ASSETS",
    "run_worker_first": ["/mcp", "/mcp/*", "/weather"],
  },
  "ratelimits": [
    {
      "name": "MCP_LIMITER",
      "namespace_id": "2001",
      "simple": { "limit": 20, "period": 60 },
    },
  ],
  "previews": {
    "ratelimits": [
      {
        "name": "MCP_LIMITER",
        "namespace_id": "2002",
        "simple": { "limit": 20, "period": 60 },
      },
    ],
  },
}
